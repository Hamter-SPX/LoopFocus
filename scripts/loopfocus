#!/usr/bin/env bash
# LoopFocus CLI — unified dispatcher
# usage: loopfocus <command> [args]
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  cat << 'EOF'
LoopFocus CLI

  mode resolve "<prompt>"          pick the operating mode from the request
  mode show <mode>                 print a mode's full contract
  mode list                        list all modes
  mode check <mode>                check a mode's close conditions (mode-state)

  init                             scaffold .loopfocus/ (state, ledger, profile, gates.conf)
  discover                         run tool auto-discovery → gates.conf + tool-map

  gates                            run the profile's machine gates
  fast                             local fast gate: build → static → test
  verify                           completion gate
  dod                              walk the DoD graph node by node

  signal <args>                    normalize a tool result (normalize-signal.js)
  genome record|query|summary <args>   Loop Genome + Failure Memory
  converge <args>                  Convergence Engine verdict from a sequence or class
  fingerprint <args>               repeat-check an attempt before executing
  entropy <args>                   Solution Entropy check

  predictive --target <f>          touch map + risk factors for a module
  critical-path <graph.json>       compute the completion-critical path
  state                            git state: changed files, commits, diff stat
  branch-new <name>                git worktree branch for an attempt
  handoff "<request>"              package the 6-part handoff
  conformance                      audit the skill itself

  ci runs|failed-jobs|logs|rerun-failed|artifacts <id>   GitHub Actions controller
EOF
}

cmd="${1:-}"
shift || true

case "$cmd" in
  mode)
    sub="${1:-}"
    shift || true
    if [ "$sub" = "check" ]; then node "$ROOT/scripts/mode.js" check "$@"; else node "$ROOT/scripts/mode.js" "$sub" "$@"; fi
    ;;
  init) bash "$ROOT/scripts/state-init.sh" ;;
  discover) bash "$ROOT/scripts/tool-discovery.sh" ;;
  gates) bash "$ROOT/scripts/gate-runner.sh" ;;
  fast) bash "$ROOT/scripts/fast-gate.sh" ;;
  verify) bash "$ROOT/scripts/loopfocus-verify.sh" ;;
  dod) bash "$ROOT/scripts/dod.sh" ;;
  signal) node "$ROOT/scripts/normalize-signal.js" "$@" ;;
  genome) node "$ROOT/scripts/loop-genome.js" "$@" ;;
  converge) node "$ROOT/scripts/convergence.js" "$@" ;;
  fingerprint) node "$ROOT/scripts/loop-fingerprint.js" "$@" ;;
  entropy) node "$ROOT/scripts/entropy.js" "$@" ;;
  predictive) node "$ROOT/scripts/predictive.js" "$@" ;;
  critical-path) node "$ROOT/scripts/critical-path.js" "$@" ;;
  state) node "$ROOT/scripts/git-state.js" ;;
  branch-new) node "$ROOT/scripts/git-state.js" worktree-new "$@" ;;
  handoff) bash "$ROOT/scripts/handoff.sh" "$@" ;;
  conformance) bash "$ROOT/scripts/loopfocus-conformance.sh" ;;
  ci) node "$ROOT/scripts/ci-controller.js" "$@" ;;
  help|-h|--help|"") usage ;;
  *) echo "unknown command: $cmd"; usage; exit 2 ;;
esac
