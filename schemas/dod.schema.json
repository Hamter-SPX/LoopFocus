{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoopFocus DoD Chain",
  "description": ".loopfocus/dod.md contract — ordered completion conditions, each with an evidence command",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string", "description": "the evidence command; empty = UNVERIFIED" }
        }
      }
    }
  }
}
